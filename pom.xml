<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>2.7.18</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.clubchretien</groupId>
	<artifactId>abonnement-service</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>abonnement-service</name>
	<description>Service de gestion des abonnements</description>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>17</java.version>

        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <sentry.version>5.6.0</sentry.version>
        <velocity.version>1.7</velocity.version>
        <spring-cloud.version>2021.0.3</spring-cloud.version>
		<swagger.version>1.6.9</swagger.version>
		<springdoc.version>1.6.9</springdoc.version>
		<postgresql.version>42.6.0</postgresql.version>
		<jwt.version>0.11.5</jwt.version>
		<jackson.version>2.13.3</jackson.version>
        <owomi.database.version>1.0-SNAPSHOT</owomi.database.version>
        <owomi.commons.version>1.0-SNAPSHOT</owomi.commons.version>
        <owomi.security.version>1.0-SNAPSHOT</owomi.security.version>
        <owomi.file.manager.version>1.0-SNAPSHOT</owomi.file.manager.version>
        <owomi.rest.client.version>1.0-SNAPSHOT</owomi.rest.client.version>
        <owomi.jwt-lib.version>1.0-SNAPSHOT</owomi.jwt-lib.version>
        <owomi.mailer.version>1.0-SNAPSHOT</owomi.mailer.version>
        <owomi.message.publisher.version>1.0-SNAPSHOT</owomi.message.publisher.version>
        <owomi.velocity.version>1.0-SNAPSHOT</owomi.velocity.version>

        <spring.boot.version>2.7.18</spring.boot.version>
        <dozer.version>5.5.1</dozer.version>
        <firebase.admin.version>8.1.0</firebase.admin.version>
        <jackson.version>2.13.0</jackson.version>
        <org.owasp.encoder.version>1.2.3</org.owasp.encoder.version>
        <org.owasp.esapi.esapi.version>2.4.0.0</org.owasp.esapi.esapi.version>
        <org.jsoup.jsoup.version>1.14.3</org.jsoup.jsoup.version>

        <hibernate.version>5.6.9.Final</hibernate.version>
		<validation.version>2.0.1.Final</validation.version>
		<servlet.version>4.0.1</servlet.version>
		<image.name.dev>abonnement-service_dev</image.name.dev>
        <image.name.prod>abonnement-service_prod</image.name.prod>
<!--		<image.name.staging>abonnement-service_staging</image.name.staging>-->
	</properties>
	<dependencies>
		<!-- JWT Library -->
		<dependency>
			<groupId>com.owomi</groupId>
            <artifactId>jwt-lib</artifactId>
            <version>${owomi.jwt-lib.version}</version>
		</dependency>

		<!-- Database Service -->
		<dependency>
			<groupId>owomi</groupId>
			<artifactId>database</artifactId>
			<version>${owomi.database.version}</version>
		</dependency>

		<!-- Security Service -->
		<dependency>
			<groupId>owomi</groupId>
			<artifactId>owomi-security</artifactId>
			<version>${owomi.security.version}</version>
			<exclusions>
				<exclusion>
					<groupId>javax.servlet</groupId>
					<artifactId>servlet-api</artifactId>
				</exclusion>
			</exclusions>
		</dependency>

		<!-- Rest Client Service -->
		<dependency>
			<groupId>owomi</groupId>
			<artifactId>rest-client</artifactId>
			<version>${owomi.rest.client.version}</version>
		</dependency>

        <dependency>
			<groupId>owomi</groupId>
			<artifactId>commons</artifactId>
			<version>${owomi.commons.version}</version>
		</dependency>

        <dependency>
            <groupId>com.owomi</groupId>
            <artifactId>owomi-velocity</artifactId>
            <version>${owomi.velocity.version}</version>
        </dependency>

        <!-- File Manager -->
        <dependency>
            <groupId>owomi</groupId>
            <artifactId>file-manager</artifactId>
            <version>${owomi.file.manager.version}</version>
        </dependency>

        <!-- Message Publisher -->
        <dependency>
            <groupId>com.owomi.message.publisher</groupId>
            <artifactId>owomi-message-publisher</artifactId>
            <version>${owomi.message.publisher.version}</version>
        </dependency>


        <dependency>
            <groupId>org.owasp.encoder</groupId>
            <artifactId>encoder</artifactId>
            <version>${org.owasp.encoder.version}</version>
        </dependency>
        <dependency>
            <groupId>org.owasp.encoder</groupId>
            <artifactId>encoder-jsp</artifactId>
            <version>${org.owasp.encoder.version}</version>
        </dependency>
        <dependency>
            <groupId>org.owasp.esapi</groupId>
            <artifactId>esapi</artifactId>
            <version>${org.owasp.esapi.esapi.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-simple</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>${org.jsoup.jsoup.version}</version>
        </dependency>

        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
            <version>3.1.8</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>


		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<version>${postgresql.version}</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.hibernate.validator</groupId>
			<artifactId>hibernate-validator</artifactId>
			<version>6.0.13.Final</version>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-ui</artifactId>
			<version>1.7.0</version>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
        </dependency>

    </dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

    <profiles>
        <profile>
            <id>prod</id>
            <properties>
                <spring.profiles.active>prod</spring.profiles.active>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <configuration>
                            <mainClass>com.clubchretien.abonnement.application.AbonnementServiceApplication</mainClass>
                            <layout>ZIP</layout>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>repackage</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>com.spotify</groupId>
                        <artifactId>docker-maven-plugin</artifactId>
                        <configuration>
                            <imageName>${image.name.prod}</imageName>
                            <dockerDirectory>docker</dockerDirectory>
                            <forceTags>true</forceTags>
                            <imageTags>
                                <imageTag>mvp</imageTag>
                            </imageTags>
                            <resources>
                                <resource>
                                    <targetPath>/</targetPath>
                                    <directory>${project.build.directory}</directory>
                                    <include>${project.build.finalName}.jar</include>
                                </resource>
                            </resources>
                        </configuration>
                        <executions>
                            <execution>
                                <id>build-image</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>build</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>dev</id>
            <properties>
                <spring.profiles.active>dev</spring.profiles.active>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <configuration>
                            <mainClass>com.clubchretien.abonnement.application.AbonnementServiceApplication</mainClass>
                            <layout>ZIP</layout>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>repackage</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>com.spotify</groupId>
                        <artifactId>docker-maven-plugin</artifactId>
                        <configuration>
                            <imageName>${image.name.dev}</imageName>
                            <dockerDirectory>docker</dockerDirectory>
                            <forceTags>true</forceTags>
                            <imageTags>
                                <imageTag>mvp</imageTag>
                            </imageTags>
                            <resources>
                                <resource>
                                    <targetPath>/</targetPath>
                                    <directory>${project.build.directory}</directory>
                                    <include>${project.build.finalName}.jar</include>
                                </resource>
                            </resources>
                        </configuration>
                        <executions>
                            <execution>
                                <id>build-image</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>build</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>staging</id>
            <properties>
                <spring.profiles.active>staging</spring.profiles.active>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <configuration>
                            <mainClass>com.clubchretien.abonnement.application.AbonnementServiceApplication</mainClass>
                            <layout>ZIP</layout>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>repackage</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>com.spotify</groupId>
                        <artifactId>docker-maven-plugin</artifactId>
                        <configuration>
                            <imageName>${image.name.staging}</imageName>
                            <dockerDirectory>docker</dockerDirectory>
                            <forceTags>true</forceTags>
                            <imageTags>
                                <imageTag>mvp</imageTag>
                            </imageTags>
                            <resources>
                                <resource>
                                    <targetPath>/</targetPath>
                                    <directory>${project.build.directory}</directory>
                                    <include>${project.build.finalName}.jar</include>
                                </resource>
                            </resources>
                        </configuration>
                        <executions>
                            <execution>
                                <id>build-image</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>build</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>



</project>
